{
  "format": "knobdeck-registry-profile",
  "version": 1,
  "id": "meetings",
  "kind": "deck",
  "name": "Meetings",
  "summary": "Mic mute, audio devices, a meeting timer and quick window moves.",
  "description": "For calls in any app: toggle the microphone at the OS level, switch output and input devices, keep a 25-minute timer and a stopwatch, and snap the call window aside.",
  "author": "KnobDeck",
  "profileVersion": "1.0.0",
  "tags": [
    "Communication",
    "Productivity"
  ],
  "plugins": [
    {
      "id": "clocks",
      "name": "Clocks"
    },
    {
      "id": "os-tools",
      "name": "OS Tools",
      "builtin": true
    }
  ],
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "skippedOn": {},
