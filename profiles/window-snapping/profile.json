{
  "format": "knobdeck-registry-profile",
  "version": 1,
  "id": "window-snapping",
  "kind": "dial",
  "name": "Window Snapping",
  "summary": "Snap the focused window to halves and corners, or move it to the next screen.",
  "description": "Halves, quarters, maximize, center and next monitor for the window under focus, through the OS window APIs.",
  "author": "KnobDeck",
  "profileVersion": "1.0.0",
  "tags": [
    "Productivity",
    "Windows"
  ],
  "plugins": [
    {
      "id": "os-tools",
      "name": "OS Tools",
      "builtin": true
    }
  ],
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "skippedOn": {
    "windows": 1
  },
  "ready": true,
  "toConfigure": [],
  "items": 14,
  "profile": {
    "name": "Window Snapping",
    "icon": "layout-grid",
    "items": [
      {
        "label": "Top Half",
        "kind": {
          "type": "button",
          "plugin": "os-tools",
          "action_type": "os-tools/move-top-half",
          "inputs": {
            "monitor": "current"
          }
        },
        "icon": "panel-top",
        "id": "window-snapping-item1"
      },
      {
        "label": "Top Right",
